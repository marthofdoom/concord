{
  "arch": "amd64",
  "cores": 2,
  "digest": "0000000000000000000000000000000000000004",
  "features": "nesting=1",
  "hostname": "guest-101",
  "lxc": [
    [
      "lxc.cgroup2.devices.allow",
      "c 10:200 rwm"
    ],
    [
      "lxc.mount.entry",
      "/dev/net/tun dev/net/tun none bind,create=file"
    ]
  ],
  "memory": 3072,
  "net0": "name=eth0,bridge=vmbr0,firewall=1,hwaddr=02:00:00:00:00:03,ip=dhcp,type=veth",
  "onboot": 1,
  "ostype": "debian",
  "rootfs": "local-lvm:vm-101-disk-0,size=48G",
  "swap": 512
}
