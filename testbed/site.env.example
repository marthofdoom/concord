# Site settings for testbed/nested and testbed/nestview. Copy to testbed/site.env (gitignored),
# replace every value, then: chmod 600 testbed/site.env
#
# Format: KEY=value, one per line. The file is PARSED, never sourced: no quoting, no expansion, no
# shell. Unknown and repeated keys are errors. Nothing here can change a safety constant (VMID
# range, pool, names, identity markers); those are read-only in testbed/nested/lib.sh.
# Every key is required. CHANGE_ME values and RFC 5737 addresses are refused as placeholders.

# PVE node name of the host that runs the estate (as in the GUI tree).
NODE=CHANGE_ME

# Address of that host's API, host:port.
PVE_API=192.0.2.10:8006

# SHA-256 fingerprint of the certificate the API serves. Read it on the host itself:
#   openssl x509 -noout -fingerprint -sha256 -in /etc/pve/local/pveproxy-ssl.pem   (or pve-ssl.pem)
PVE_FINGERPRINT=CHANGE_ME

# Absolute path of a file holding one line, USER@REALM!TOKENID=SECRET, for an administrator token.
# Must be yours and mode 0600 (or 0400).
PVE_TOKEN_FILE=/CHANGE_ME/pve-admin-token.txt

# The LAN IPv4 address of this host (where build.sh runs). install-pve.sh proves from inside a node that
# its port 22 is NOT reachable; build.sh first checks that the address is local and the port answers.
HOST_LAN_IP=192.0.2.10

# Mount point the estate's storage lives on; the storage itself is <mountpoint>/concord-nest, and
# goes offline instead of filling the root disk when this is not mounted.
STORAGE_MOUNTPOINT=/CHANGE_ME

# Directory (yours, 0700) where build.sh keeps the estate's SSH key, token and known_hosts.
SECRETS_DIR=/CHANGE_ME/secrets

# One-line file (yours, 0600) with the root password for the nested nodes' own GUIs. There is no
# default password: create the file before building.
NODE_ROOT_PASSWORD_FILE=/CHANGE_ME/secrets/concord-nest-root-password.txt
